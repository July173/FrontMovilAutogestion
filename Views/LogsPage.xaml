<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSena.MAUI.Views.LogsPage"
             xmlns:viewmodels="clr-namespace:AutogestionSena.MAUI.ViewModels"
             x:DataType="viewmodels:LogsViewModel"
             Title="Logs del Sistema"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">
        
        <!-- Barra de acciones -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Margin="0,0,0,10">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="5" Offset="0,2"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="15" ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="Logs en Tiempo Real"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
                
                <Button Grid.Column="1"
                        Text="🔄 Refrescar"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#0D6EFD"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5"
                        CornerRadius="5"/>
                
                <Button Grid.Column="2"
                        Text="📤 Exportar"
                        Command="{Binding ExportLogsCommand}"
                        BackgroundColor="#198754"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5"
                        CornerRadius="5"/>
                
                <Button Grid.Column="3"
                        Text="🗑️ Limpiar"
                        Command="{Binding ClearLogsCommand}"
                        BackgroundColor="#DC3545"
                        TextColor="White"
                        FontSize="12"
                        Padding="10,5"
                        CornerRadius="5"/>
            </Grid>
        </Border>

        <!-- Lista de logs -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="5" Offset="0,2"/>
            </Border.Shadow>
            
            <CollectionView ItemsSource="{Binding Logs}"
                           SelectionMode="None"
                           EmptyView="No hay logs disponibles">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:LogItemViewModel">
                        <Border BackgroundColor="Transparent"
                                Padding="10,5"
                                Margin="5,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5"/>
                            </Border.StrokeShape>
                            
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                                <!-- Cabecera: Nivel y Timestamp -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0"
                                            BackgroundColor="{Binding ColorCode}"
                                            Padding="8,2"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="3"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Level}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold"/>
                                    </Border>
                                    
                                    <Label Grid.Column="1"
                                           Text="{Binding Source}"
                                           FontSize="11"
                                           TextColor="#6C757D"
                                           FontAttributes="Italic"
                                           VerticalOptions="Center"/>
                                    
                                    <Label Grid.Column="2"
                                           Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss.fff}'}"
                                           FontSize="10"
                                           TextColor="#6C757D"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- Mensaje -->
                                <Label Grid.Row="1"
                                       Text="{Binding Message}"
                                       FontSize="12"
                                       TextColor="#212529"
                                       LineBreakMode="WordWrap"/>
                                
                                <!-- Exception (si existe) -->
                                <Label Grid.Row="2"
                                       Text="{Binding ExceptionText}"
                                       FontSize="10"
                                       TextColor="#DC3545"
                                       FontFamily="Courier"
                                       LineBreakMode="WordWrap"
                                       IsVisible="{Binding HasException}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- Información inferior -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Margin="0,10,0,0"
                Padding="15,10">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="5" Offset="0,2"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding LogCountText}"
                       FontSize="12"
                       TextColor="#6C757D"
                       VerticalOptions="Center"/>
                
                <Label Grid.Column="1"
                       Text="{Binding LogFilePath}"
                       FontSize="10"
                       TextColor="#6C757D"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center"
                       MaximumWidthRequest="200"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
