<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AutogestionSena.MAUI.Views"
             x:Class="AutogestionSena.MAUI.Views.PasswordResetPage"
             BackgroundColor="White">
    <Grid>
    <ScrollView>
        <Grid Padding="0" HorizontalOptions="FillAndExpand">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.05*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="0.05*"/>
            </Grid.ColumnDefinitions>
            <VerticalStackLayout Padding="20" Spacing="18" Grid.Column="1">
            <!-- Volver a inicio de sesión -->
                <Button x:Name="BackToLoginButton" Text="Volver a inicio de sesión"
                    BackgroundColor="#43a047"
                    TextColor="White"
                    FontFamily="Roboto-Regular"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Margin="0,0,0,10"
                    Clicked="OnBackToLoginClicked"/>
            <!-- Logo SENA -->
            <Image x:Name="ResetLogoImage"
                   Source="../Resources/AppIcon/LogoSenaVerde.svg" 
                   Aspect="AspectFill" 
                   HeightRequest="90" 
                   WidthRequest="90"
                   HorizontalOptions="Center"/>
            <!-- Título -->
                 <Label x:Name="ResetTitleLabel" Text="AutoGestión CIES"
                   FontFamily="Roboto-Bold"
                     FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#43A047"
                   HorizontalOptions="Center"/>
            <!-- Subtítulo -->
                 <Label x:Name="ResetSubtitleLabel" Text="Restablecer contraseña"
                   FontFamily="Roboto-Bold"
                     FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#424242"
                   HorizontalOptions="Center"/>
            <Label Text="Ingresa tu nueva contraseña."
                   FontFamily="Roboto-Regular"
                   FontSize="20"
                   TextColor="#757575"
                   HorizontalOptions="Center"/>
            
            <!-- Input Nueva Contraseña -->
            <Frame BorderColor="#e5e7eb" CornerRadius="6" BackgroundColor="White" Padding="0" HasShadow="False" HorizontalOptions="FillAndExpand">
                <Grid Padding="10,0" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" 
                           Text="&#xf084;" 
                           FontFamily="FA_Solid" 
                           FontSize="24" 
                           TextColor="#757575" 
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                            <Entry x:Name="NewPasswordEntry" 
                           Grid.Column="1" 
                           Placeholder="Nueva contraseña" 
                           IsPassword="True"
                           FontSize="16" 
                           TextColor="#424242" 
                            FontFamily="Roboto-Regular" HorizontalOptions="FillAndExpand"/>
                </Grid>
            </Frame>
            
            <!-- Input Confirmar Contraseña -->
            <Frame BorderColor="#e5e7eb" CornerRadius="6" BackgroundColor="White" Padding="0" HasShadow="False" HorizontalOptions="FillAndExpand">
                <Grid Padding="10,0" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" 
                           Text="&#xf084;" 
                           FontFamily="FA_Solid" 
                           FontSize="24" 
                           TextColor="#757575" 
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>
                            <Entry x:Name="ConfirmPasswordEntry" 
                           Grid.Column="1" 
                           Placeholder="Confirmar contraseña" 
                           IsPassword="True"
                           FontSize="16" 
                           TextColor="#424242" 
                            FontFamily="Roboto-Regular" HorizontalOptions="FillAndExpand"/>
                </Grid>
            </Frame>
            
            <!-- Botón Restablecer -->
                    <Button x:Name="ResetButton" Text="Restablecer contraseña"
                    BackgroundColor="#388e3c"
                    TextColor="White"
                    FontFamily="Roboto-SemiBold"
                    FontSize="18"
                    CornerRadius="8"
                    HeightRequest="54"
                    Margin="0,10,0,0"
                    HorizontalOptions="FillAndExpand"
                    Clicked="OnResetPasswordClicked"/>
            <!-- Soporte, Términos, Privacidad -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,20,0,0">
                <Label Text="Soporte" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSupportTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Términos de Uso" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTermsTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Política de Privacidad" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
    
    <!-- Modales de Términos, Privacidad y Soporte -->
    <local:SupportModalView x:Name="SupportModalView" />
    <local:LegalModalView x:Name="LegalModalView" />
    <local:PrivacyModalView x:Name="PrivacyModalView" />
    </Grid>
</ContentPage>
