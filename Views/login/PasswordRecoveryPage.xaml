<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSena.MAUI.Views.PasswordRecoveryPage"
             BackgroundColor="White">
    <ScrollView>
        <Grid Padding="0" HorizontalOptions="FillAndExpand">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.05*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.05*" />
            </Grid.ColumnDefinitions>
            <VerticalStackLayout Padding="20" Spacing="20" Grid.Column="1">
            <!-- Volver a inicio de sesión -->
            <Button Text="Volver a inicio de sesión"
                    BackgroundColor="#43a047"
                    TextColor="White"
                    FontFamily="Roboto-Regular"
                    FontSize="16"
                    CornerRadius="10"
                    HeightRequest="50"
                    HorizontalOptions="Start"
                    Padding="15,0"
                    Clicked="OnBackToLoginClicked"/>
            <!-- Logo -->
            <Frame Padding="0" HasShadow="False" CornerRadius="75" HeightRequest="150" WidthRequest="150" BackgroundColor="Transparent" HorizontalOptions="Center" Margin="0,20,0,0">
                <Image Source="https://www.figma.com/api/mcp/asset/835afbaf-5f9f-40ba-a645-a69ea42f4d72" Aspect="AspectFill"/>
            </Frame>
            <!-- Título -->
            <Label Text="AutoGestión CIES"
                   FontFamily="Roboto-Bold"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#43A047"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <!-- Subtítulo -->
            <Label Text="Recuperar Contraseña"
                   FontFamily="Roboto-Bold"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#424242"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0"/>
            <Label Text="Ingresa tu correo electrónico para recibir un código de recuperación."
                   FontFamily="Roboto-Regular"
                   FontSize="16"
                   TextColor="#757575"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,10"/>
            <!-- Input correo -->
            <Frame BorderColor="#e0e0e0" CornerRadius="8" Padding="0" HasShadow="False" BackgroundColor="White" Margin="0,10,0,0">
                <Grid Padding="15,0" HeightRequest="60" VerticalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="https://www.figma.com/api/mcp/asset/d95f9c2b-a510-4aa4-841d-bea027d386ac" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Margin="0,0,10,0"/>
                    <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="ejemplo@soy.sena.edu.co" FontSize="16" TextColor="#424242" BackgroundColor="Transparent" FontFamily="Roboto-Regular" VerticalOptions="Center"/>
                </Grid>
            </Frame>
            <!-- Botón Enviar Código -->
                <Button x:Name="SendButton"
                    Text="Enviar Código"
                    BackgroundColor="#388e3c"
                    TextColor="White"
                    FontFamily="Roboto-SemiBold"
                    FontSize="18"
                    CornerRadius="8"
                    HeightRequest="56"
                    Margin="0,20,0,0"
                    Clicked="OnSendCodeClicked"
                    HorizontalOptions="FillAndExpand"/>
            <!-- Soporte, Términos, Privacidad -->
            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignItems="Center" Margin="0,30,0,10">
                <Label Text="Soporte" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular" Margin="5"/>
                <Label Text="Términos de Uso" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular" Margin="5"/>
                <Label Text="Política de Privacidad" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular" Margin="5"/>
            </FlexLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
