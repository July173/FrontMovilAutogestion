<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AutogestionSena.MAUI.Views"
             x:Class="AutogestionSena.MAUI.Views.LoginPage"
             BackgroundColor="White">
    <Grid>
        <ScrollView>
        <VerticalStackLayout Padding="30,40" Spacing="30" HorizontalOptions="Center" MaximumWidthRequest="600">
            <!-- Logo -->
            <Frame Padding="0" HasShadow="False" CornerRadius="40" HeightRequest="80" WidthRequest="80" BackgroundColor="Transparent" HorizontalOptions="Center">
                <Image Source="../Resources/AppIcon/LogoSenaVerde.svg" Aspect="AspectFill" HeightRequest="80" WidthRequest="80"/>
            </Frame>
            <!-- Título -->
            <Label Text="AutoGestión CIES"
                   FontFamily="Roboto-Bold"
                   FontSize="29"
                   FontAttributes="Bold"
                   TextColor="#43A047"
                   HorizontalOptions="Center"/>
            <!-- Subtítulo -->
            <Label Text="Iniciar Sesión"
                   FontFamily="Roboto-Bold"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="Black"
                   HorizontalOptions="Center"/>
            <Label Text="Ingresa tus credenciales para acceder a tu cuenta."
                   FontFamily="Roboto-Regular"
                   FontSize="20"
                   TextColor="#757575"
                   HorizontalOptions="Center"/>
            <!-- Inputs -->
            <VerticalStackLayout Spacing="17">
                <!-- Email -->
                <Frame BorderColor="#e0e0e0" CornerRadius="8" Padding="0" HasShadow="False" BackgroundColor="White">
                    <Grid Padding="17,0" HeightRequest="50" VerticalOptions="Center" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="&#xf0e0;" FontFamily="FA_Solid" FontSize="20" TextColor="#757575" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Entry x:Name="UsernameEntry" Grid.Column="1" Placeholder="ejemplo@soy.sena.edu.co" FontSize="16" TextColor="#424242" FontFamily="Roboto-Regular" BackgroundColor="White"/>
                    </Grid>
                </Frame>
                <!-- Password -->
                <Frame BorderColor="#e0e0e0" CornerRadius="8" Padding="0" HasShadow="False" BackgroundColor="White">
                    <Grid Padding="18,0" HeightRequest="50" VerticalOptions="Center" BackgroundColor="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="&#xf023;" FontFamily="FA_Solid" FontSize="20" TextColor="#757575" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Contraseña" IsPassword="True" FontSize="16" TextColor="#424242" FontFamily="Roboto-Regular" BackgroundColor="White"/>
                    </Grid>
                </Frame>
            </VerticalStackLayout>
            <!-- ¿Olvidaste tu contraseña? -->
                <Label Text="¿Olvidaste tu contraseña?" FontFamily="Roboto-Bold" FontSize="18" TextColor="#43A047" HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnForgotPasswordTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <!-- Indicador de carga -->
            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="#43A047" />
            <!-- Botón Iniciar Sesión -->
            <Button Text="Iniciar Sesión"
                    BackgroundColor="#388e3c"
                    TextColor="White"
                    FontFamily="Roboto-SemiBold"
                    FontSize="30"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Clicked="OnLoginClicked"
                    />
            <!-- ¿No tienes una cuenta? Regístrate aquí -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="¿No tienes una cuenta?" FontSize="20" TextColor="#757575" FontFamily="Roboto-Regular"/>
                <Label Text="Regístrate aquí" FontSize="20" TextColor="#43A047" FontFamily="Roboto-Medium">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterLinkTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
            <!-- Soporte, Términos, Privacidad -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,20,0,0">
                <Label Text="Soporte" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSupportTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Términos de Uso" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTermsTapped"/>
                    </Label.GestureRecognizers>
                </Label>
                <Label Text="Política de Privacidad" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrivacyTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
        
        <!-- Modal de segundo factor -->
        <local:TwoFactorModal x:Name="TwoFactorModal" />
        
        <!-- Modales de Términos, Privacidad y Soporte -->
        <local:SupportModalView x:Name="SupportModalView" />
        <local:LegalModalView x:Name="LegalModalView" />
        <local:PrivacyModalView x:Name="PrivacyModalView" />
    </Grid>
</ContentPage>
