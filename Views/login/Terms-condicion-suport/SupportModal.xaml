<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSena.MAUI.Views.SupportModalView">

    <Grid x:Name="ModalContainer" BackgroundColor="#80000000" IsVisible="False" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <!-- Centro del modal -->
        <Frame x:Name="ModalFrame" Padding="18" CornerRadius="10" BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True" WidthRequest="700">
            <VerticalStackLayout Spacing="12">
                <!-- Cabecera: icono + título + close -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <!-- Icono de pregunta con Font Awesome -->
                    <Frame WidthRequest="44" HeightRequest="44" CornerRadius="22" BackgroundColor="#43A047" Padding="8" HasShadow="False" VerticalOptions="Center">
                        <Label Text="&#xf059;" 
                               FontFamily="FA_Solid" 
                               FontSize="20" 
                               TextColor="White" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Frame>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="CenterAndExpand">
                        <Label x:Name="TitleLabel" Text="Centro de soporte" FontSize="20" FontAttributes="Bold" TextColor="#000000" HorizontalOptions="Center" />
                        <Label x:Name="SubtitleLabel" Text="Estamos aquí para ayudarte. Encuentra respuestas rápidas o contáctanos directamente." FontSize="13" TextColor="#000000" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2" Text="✕" BackgroundColor="Transparent" TextColor="#616161" FontSize="18" WidthRequest="40" HeightRequest="40" Clicked="OnCloseClicked" />
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#eeeeee" />

                <!-- Contenido principal -->
                <ScrollView x:Name="ContentScroll" HeightRequest="520">
                    <VerticalStackLayout x:Name="ContentStack" Spacing="12" Padding="12" />
                </ScrollView>

                <!-- Pie: botón cerrar pequeño para accesibilidad -->
                <HorizontalStackLayout HorizontalOptions="End">
                    <Button Text="Cerrar" BackgroundColor="Transparent" TextColor="#000000" Clicked="OnCloseClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentView>
