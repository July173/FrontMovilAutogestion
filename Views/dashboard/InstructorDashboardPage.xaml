<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="AutogestionSenaMaui.Views.InstructorDashboardPage"
 Title="Dashboard - Instructor">

 <ScrollView>
 <VerticalStackLayout Spacing="32" Padding="24,24,24,0">
 <!-- Título grande superior -->
 <Frame BackgroundColor="White"
 CornerRadius="12"
 Padding="16,24"
 HasShadow="False"
 HorizontalOptions="FillAndExpand">
 <Label Text="BIENVENIDO A AUTOGESTIÓN SENA"
 FontSize="32"
 FontAttributes="Bold"
 TextColor="#219653"
 HorizontalTextAlignment="Center"
 FontFamily="Arial"/>
 </Frame>

 <!-- Botón de recargar -->
 <Frame x:Name="RefreshButton"
 BackgroundColor="#219653"
 CornerRadius="12"
 HeightRequest="48"
 Padding="20,0"
 HasShadow="True"
 HorizontalOptions="Center">
 <Frame.GestureRecognizers>
 <TapGestureRecognizer Tapped="OnRefreshClicked"/>
 </Frame.GestureRecognizers>
 <HorizontalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
 <!-- Ícono de refresh (visible cuando no está cargando) -->
 <Label x:Name="RefreshIcon"
 Text="&#xf021;"
 FontFamily="FA_Solid"
 FontSize="18"
 TextColor="White"
 VerticalOptions="Center"/>
 <!-- ActivityIndicator (visible cuando está cargando) -->
 <ActivityIndicator x:Name="RefreshSpinner"
 IsRunning="False"
 IsVisible="False"
 Color="White"
 HeightRequest="20"
 WidthRequest="20"
 VerticalOptions="Center"/>
 <Label x:Name="RefreshButtonText"
 Text="Actualizar Dashboard"
 FontSize="16"
 FontAttributes="Bold"
 TextColor="White"
 VerticalOptions="Center"/>
 </HorizontalStackLayout>
 </Frame>

 <!-- Indicador de carga -->
 <ActivityIndicator x:Name="LoadingIndicator" 
      IsRunning="False" 
      IsVisible="False" 
      Color="#219653"
      HorizontalOptions="Center" />

 <!-- Tarjetas resumen con scroll horizontal -->
 <ScrollView Orientation="Horizontal" 
       HorizontalScrollBarVisibility="Default"
       HorizontalOptions="FillAndExpand">
 <HorizontalStackLayout x:Name="StatsContainer" Spacing="24" Padding="0,0,24,0">
 <!-- Tarjeta1 - Visitas Programadas -->
 <Frame BackgroundColor="White"
 BorderColor="#BDBDBD"
 CornerRadius="14"
 Padding="18"
 WidthRequest="260"
 HasShadow="False">
 <VerticalStackLayout Spacing="8">
 <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
 <Label Text="Visitas programadas" 
    FontSize="15" 
    TextColor="#222" 
    VerticalOptions="Center"
    Grid.Column="0" />
 <Frame BackgroundColor="#A5EEC5" 
   CornerRadius="16" 
   HeightRequest="32" 
   WidthRequest="32" 
   Padding="0" 
   HasShadow="False"
   Grid.Column="1">
 <Label Text="&#xf274;" FontFamily="FA_Solid" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#219653" />
 </Frame>
 </Grid>
 <Label x:Name="VisitasProgramadasLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#222" />
 <Label Text="Para esta semana" FontSize="13" TextColor="#444" />
 </VerticalStackLayout>
 </Frame>
 <!-- Tarjeta2 - Aprendices Asignados -->
 <Frame BackgroundColor="White"
 BorderColor="#BDBDBD"
 CornerRadius="14"
 Padding="18"
 WidthRequest="260"
 HasShadow="False">
 <VerticalStackLayout Spacing="8">
 <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
 <Label Text="Aprendices Asignados" 
    FontSize="15" 
    TextColor="#222" 
    VerticalOptions="Center"
    Grid.Column="0" />
 <Frame BackgroundColor="#A5EEC5" 
   CornerRadius="16" 
   HeightRequest="32" 
   WidthRequest="32" 
   Padding="0" 
   HasShadow="False"
   Grid.Column="1">
 <Label Text="&#xf501;" FontFamily="FA_Solid" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#219653" />
 </Frame>
 </Grid>
 <Label x:Name="AprendicesAsignadosLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#222" />
 <Label Text="Aprendices asignados para evaluar" FontSize="13" TextColor="#444" />
 </VerticalStackLayout>
 </Frame>
 <!-- Tarjeta3 - Aprendices Evaluados -->
 <Frame BackgroundColor="White"
 BorderColor="#BDBDBD"
 CornerRadius="14"
 Padding="18"
 WidthRequest="260"
 HasShadow="False">
 <VerticalStackLayout Spacing="8">
 <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
 <Label Text="Aprendices Evaluados" 
    FontSize="15" 
    TextColor="#222" 
    VerticalOptions="Center"
    Grid.Column="0" />
 <Frame BackgroundColor="#A5EEC5" 
   CornerRadius="16" 
   HeightRequest="32" 
   WidthRequest="32" 
   Padding="0" 
   HasShadow="False"
   Grid.Column="1">
 <Label Text="&#xf4fc;" FontFamily="FA_Solid" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#219653" />
 </Frame>
 </Grid>
 <Label x:Name="AprendicesEvaluadosLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="#222" />
 <Label Text="Aprendices evaluados" FontSize="13" TextColor="#444" />
 </VerticalStackLayout>
 </Frame>
 </HorizontalStackLayout>
 </ScrollView>

 <!-- Título principal -->
 <Label Text="Próximas Visitas"
 FontSize="24"
 FontAttributes="Bold"
 TextColor="#222"
 Margin="0,0,0,10" />

 <!-- Mensaje cuando no hay visitas -->
 <Frame x:Name="NoVisitasFrame" 
  BackgroundColor="White"
  BorderColor="#E0E0E0"
  CornerRadius="16"
  Padding="32"
  HasShadow="True"
  IsVisible="False"
  HorizontalOptions="FillAndExpand"
  Margin="0,0,0,24">
 <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
 <Frame BackgroundColor="#F5F5F5" 
   CornerRadius="40" 
   HeightRequest="80" 
   WidthRequest="80" 
   Padding="0" 
   HasShadow="False"
   HorizontalOptions="Center">
 <Label Text="&#xf274;" 
    FontFamily="FA_Solid" 
    FontSize="36" 
    TextColor="#BDBDBD" 
    HorizontalOptions="Center" 
    VerticalOptions="Center" />
 </Frame>
 <Label Text="No hay visitas programadas" 
    FontSize="20" 
    FontAttributes="Bold"
    TextColor="#444" 
    HorizontalTextAlignment="Center" />
 <Label Text="Por el momento no tienes visitas pendientes.&#x0a;Cuando tengas nuevas visitas asignadas aparecerán aquí." 
    FontSize="14" 
    TextColor="#888" 
    HorizontalTextAlignment="Center"
    LineBreakMode="WordWrap" />
 </VerticalStackLayout>
 </Frame>

 <!-- Contenedor de tarjetas de visitas con scroll horizontal -->
 <ScrollView x:Name="VisitasScrollView"
       Orientation="Horizontal" 
       HorizontalScrollBarVisibility="Default"
       HorizontalOptions="FillAndExpand">
 <HorizontalStackLayout x:Name="VisitasContainer" 
         Spacing="24" 
         Padding="0,0,24,16">
 <!-- Las tarjetas de visitas se generan dinámicamente -->
 </HorizontalStackLayout>
 </ScrollView>
 </VerticalStackLayout>
 </ScrollView>
</ContentPage>