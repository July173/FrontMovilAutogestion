<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contentviews="clr-namespace:AutogestionSenaMaui.ContentViews"
             x:Class="AutogestionSena.MAUI.Views.notificaciones.NotificacionesApp"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HeightRequest" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BackgroundColor" Value="#EFEFEF"/>
            <Setter Property="TextColor" Value="#222"/>
        </Style>

        <Style x:Key="DangerPill" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="BackgroundColor" Value="#FFDDE0"/>
            <Setter Property="TextColor" Value="#C33"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#1976D2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*" Padding="0">
        <!-- Top global bar -->
        <contentviews:TopBar Grid.Row="0" />

        <!-- Simple page title + back -->
        <Grid Grid.Row="1" Padding="12" ColumnDefinitions="*,Auto">
            <VerticalStackLayout HorizontalOptions="Start" Spacing="2">
                <Label Text="Notificaciones" FontAttributes="Bold" FontSize="20" TextColor="#333"/>
                <Label Text="{Binding SummaryText}" FontSize="13" TextColor="#666"/>
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="8">
                <Button Text="Volver al dashboard" Style="{StaticResource LinkButton}" Clicked="OnBackToDashboardClicked"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- Main content: tabs, actions and notifications list -->
        <StackLayout Grid.Row="2" Padding="12" Spacing="12">
            <!-- Tabs -->
            <Frame HasShadow="False" Padding="12" BackgroundColor="#FFFFFF" CornerRadius="8">
                <HorizontalStackLayout Spacing="8">
                    <Frame HasShadow="{Binding TabTodasHasShadow}" CornerRadius="8" Padding="0" BackgroundColor="Transparent" BorderColor="Transparent">
                        <Button x:Name="BtnTodas" Text="{Binding TodasTabText}" Clicked="OnTabTodasClicked" BackgroundColor="Transparent" TextColor="{Binding TabTodasTextColor}" Padding="12,6"/>
                    </Frame>

                    <Frame HasShadow="{Binding TabSinLeerHasShadow}" CornerRadius="8" Padding="0" BackgroundColor="Transparent" BorderColor="Transparent">
                        <Button x:Name="BtnSinLeer" Text="{Binding SinLeerTabText}" Clicked="OnTabSinLeerClicked" BackgroundColor="Transparent" TextColor="{Binding TabSinLeerTextColor}" Padding="12,6"/>
                    </Frame>
                </HorizontalStackLayout>
            </Frame>

            <!-- Summary + actions -->
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <Label Text="{Binding SummaryText}" VerticalOptions="Center" TextColor="#666" />

                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Button Text="Marcar todas leídas" Style="{StaticResource PillButton}" Clicked="OnMarkAllReadClicked" IsEnabled="{Binding IsNotLoading}" />
                    <Button Text="Eliminar todas" Style="{StaticResource DangerPill}" Clicked="OnDeleteAllClicked" IsEnabled="{Binding IsNotLoading}" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Notifications list with pull-to-refresh -->
            <RefreshView x:Name="NotificationsRefresh" IsRefreshing="False" Refreshing="OnRefreshRequested">
                <Grid>
                    <!-- Mensaje cuando no hay notificaciones -->
                    <Frame IsVisible="{Binding HasNoNotifications}"
                           BackgroundColor="#F8F9FA"
                           BorderColor="#E0E0E0"
                           CornerRadius="12"
                           Padding="32"
                           HasShadow="False"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                            <Frame BackgroundColor="#ECEFF1" 
                                   CornerRadius="40" 
                                   HeightRequest="80" 
                                   WidthRequest="80" 
                                   Padding="0" 
                                   HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label Text="&#xf0f3;" 
                                       FontFamily="FA_Solid" 
                                       FontSize="36" 
                                       TextColor="#90A4AE" 
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" />
                            </Frame>
                            <Label Text="No tienes notificaciones" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="#546E7A" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Cuando recibas nuevas notificaciones aparecerán aquí." 
                                   FontSize="14" 
                                   TextColor="#78909C" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Lista de notificaciones -->
                    <CollectionView ItemsSource="{Binding DisplayedNotifications}" 
                                    SelectionMode="None" 
                                    BackgroundColor="Transparent" 
                                    VerticalOptions="FillAndExpand"
                                    IsVisible="{Binding HasNotifications}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- Fondo y borde según estado de lectura -->
                                <Frame Margin="0,8" 
                                       Padding="12" 
                                       CornerRadius="10" 
                                       HasShadow="False" 
                                       BorderColor="{Binding CardBorderColor}" 
                                       BackgroundColor="{Binding CardBackgroundColor}">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNotificationTapped" />
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        
                                        <!-- Indicador de no leída (punto azul) -->
                                        <Frame Grid.Column="0"
                                               WidthRequest="12"
                                               HeightRequest="12"
                                               CornerRadius="6"
                                               Padding="0"
                                               HasShadow="False"
                                               BackgroundColor="#1976D2"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsUnread}"/>
                                        
                                        <!-- Contenido de la notificación -->
                                        <StackLayout Grid.Column="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Text="{Binding Title}" 
                                                       FontAttributes="{Binding TitleFontAttributes}" 
                                                       FontSize="16" 
                                                       Grid.Column="0" 
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{Binding TitleTextColor}"/>
                                                <Label Text="{Binding TimestampText}" 
                                                       FontSize="12" 
                                                       TextColor="#A0A0A0" 
                                                       Grid.Column="1" 
                                                       HorizontalOptions="End"/>
                                            </Grid>

                                            <Label Text="{Binding Message}" 
                                                   FontSize="14" 
                                                   TextColor="{Binding MessageTextColor}" 
                                                   Margin="0,6,0,0" 
                                                   LineBreakMode="TailTruncation"/>
                                        </StackLayout>

                                        <!-- Botón eliminar -->
                                        <Button Text="Eliminar" 
                                                FontSize="12" 
                                                TextColor="#D33" 
                                                BackgroundColor="Transparent" 
                                                Grid.Column="2" 
                                                VerticalOptions="Start" 
                                                Clicked="OnDeleteItemClicked" 
                                                CommandParameter="{Binding Id}"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </RefreshView>
        </StackLayout>

        <!-- Footer -->
        <contentviews:Footer Grid.Row="3" />

        <!-- Loading overlay -->
        <Grid IsVisible="{Binding IsLoading}" BackgroundColor="#80000000" HorizontalOptions="Fill" VerticalOptions="Fill" Grid.RowSpan="4">
            <Frame WidthRequest="220" HeightRequest="120" CornerRadius="12" BackgroundColor="White" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsLoading}" WidthRequest="40" HeightRequest="40" Color="#1976D2"/>
                    <Label Text="Cargando notificaciones..." FontSize="14" TextColor="#333" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
