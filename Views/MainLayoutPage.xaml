<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contentviews="clr-namespace:AutogestionSenaMaui.ContentViews"
             x:Class="AutogestionSenaMaui.Views.MainLayoutPage"
             Title="MainLayoutPage"
             Shell.NavBarIsVisible="False">
    
    <!-- 
        MainLayoutPage - Layout principal de la aplicación
        Estructura similar a MainLayout.tsx de React
        Incluye: TopBar, Contenido dinámico, Footer
    -->
    
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="#D9D9D9">
        
        <!-- Frame 425: Header/TopBar con navegación del sistema -->
        <contentviews:TopBar x:Name="TopBarView" 
                             Grid.Row="0"
                             Grid.ColumnSpan="2"/>
        
        <!-- Frame 426: Contenido principal (Menú + Dashboard) -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            
            <!-- Menú Lateral Dinámico (empuja el contenido) -->
            <contentviews:DynamicSideMenu x:Name="SideMenu"
                                          Grid.Column="0"
                                          WidthRequest="0"
                                          IsVisible="False"
                                          HorizontalOptions="Start"
                                          VerticalOptions="Fill"/>
            
            <!-- Contenido dinámico -->
            <ScrollView Grid.Column="1">
                <ContentView x:Name="MainContent"
                             BackgroundColor="#D9D9D9"
                             Padding="16">
                    <!-- El contenido se inyectará dinámicamente aquí -->
                </ContentView>
            </ScrollView>
            
        </Grid>
        
        <!-- Frame 427: Footer del sistema -->
        <contentviews:Footer x:Name="FooterView" 
                             Grid.Row="2"
                             Grid.ColumnSpan="2"/>
        
    </Grid>
    
</ContentPage>
